--[[
    EnemySpawner.luau
    Handles the physical creation and AI initialization of enemy models.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local EnemyAI = require(ServerScriptService.Systems.EnemyAI)

local EnemySpawner = {
    _activeEnemies = {}
}

function EnemySpawner:Spawn(enemyType)
    print("[EnemySpawner] Spawning enemy: " .. enemyType)
    
    -- Try to find template in ServerStorage (Generated by AssetGenerator)
    local templates = ServerStorage:FindFirstChild("EnemyTemplates")
    local template = templates and templates:FindFirstChild(enemyType)
    
    local enemyModel
    if template then
        enemyModel = template:Clone()
    else
        -- Absolute fallback if assets haven't generated
        enemyModel = Instance.new("Model")
        local p = Instance.new("Part", enemyModel)
        p.Name = "HumanoidRootPart"
        p.Size = Vector3.new(2, 2, 2)
        enemyModel.PrimaryPart = p
    end
    
    -- Ensure Humanoid exists
    if not enemyModel:FindFirstChild("Humanoid") then
        Instance.new("Humanoid", enemyModel)
    end
    
    -- Position at a random rift location (or default if none exist)
    local spawnPos = Vector3.new(math.random(-50, 50), 5, math.random(-50, 50))
    enemyModel:SetPrimaryPartCFrame(CFrame.new(spawnPos))
    
    enemyModel.Parent = workspace
    
    -- Initialize AI
    local ai = EnemyAI.new(enemyModel, {
        Damage = 5,
        AttackRange = 6,
        AttackRate = 2,
    })
    
    table.insert(self._activeEnemies, ai)
    
    -- Cleanup on death
    enemyModel.Humanoid.Died:Connect(function()
        ai:Stop()
        task.wait(2)
        enemyModel:Destroy()
    end)
    
    return enemyModel
end

return EnemySpawner
